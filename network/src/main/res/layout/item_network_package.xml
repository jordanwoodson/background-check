<?xml version='1.0' encoding='utf-8'?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    app:cardElevation="0dp"
    app:cardCornerRadius="24dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLow">
    <LinearLayout
        android:id="@+id/row_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <CheckBox
                android:id="@+id/selection_checkbox"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="0dp"
                android:contentDescription="@string/select_package"
                android:visibility="gone"
                android:clickable="false"
                android:focusable="false"/>
            <ImageView
                android:id="@+id/app_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/de1984_icon"
                android:contentDescription="@string/cd_app_icon"/>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_gravity="center_vertical"
                android:orientation="vertical">
                <!-- App Name -->
                <TextView
                    android:id="@+id/app_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/action_sheet_placeholder_app_name"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"/>
                <!-- Package Name -->
                <TextView
                    android:id="@+id/package_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/action_sheet_placeholder_package_name"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/network_mono"/>
                <!-- System Critical Badge -->
                <TextView
                    android:id="@+id/system_critical_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/firewall_badge_system_critical"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/error_red"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:background="@drawable/badge_background"
                    android:visibility="gone"/>
                <!-- VPN App Badge -->
                <TextView
                    android:id="@+id/vpn_app_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/firewall_badge_vpn_app"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#B4BEDB"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:background="@drawable/badge_background_vpn"
                    android:visibility="gone"/>
                <TextView
                    android:id="@+id/internet_recommendation_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"/>
                <!-- No Internet Permission Badge -->
                <TextView
                    android:id="@+id/no_internet_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/firewall_badge_no_internet"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#B4BEDB"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:background="@drawable/badge_background_no_internet"
                    android:visibility="gone"/>
                <!-- Profile Badge (Work/Clone) -->
                <TextView
                    android:id="@+id/profile_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#B4BEDB"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:background="@drawable/badge_background_profile"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:orientation="vertical"
            android:gravity="end|center_vertical"
            android:layout_marginTop="8dp">
            <!-- Network Status Icons Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <!-- WiFi Icon with overlay - clickable for quick toggle -->
                <FrameLayout
                    android:id="@+id/wifi_container"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:id="@+id/wifi_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_wifi"
                        android:contentDescription="@string/cd_wifi_status"/>
                    <ImageView
                        android:id="@+id/wifi_blocked_overlay"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_blocked_overlay"
                        android:visibility="gone"
                        android:contentDescription="@string/cd_wifi_blocked"/>
                </FrameLayout>
                <!-- Mobile Icon with overlay - clickable for quick toggle -->
                <FrameLayout
                    android:id="@+id/mobile_container"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:id="@+id/mobile_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_mobile"
                        android:contentDescription="@string/cd_mobile_data_status"/>
                    <ImageView
                        android:id="@+id/mobile_blocked_overlay"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_blocked_overlay"
                        android:visibility="gone"
                        android:contentDescription="@string/cd_mobile_blocked"/>
                </FrameLayout>
                <!-- Roaming Icon with overlay (conditionally visible) - clickable for quick toggle -->
                <FrameLayout
                    android:id="@+id/roaming_container"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone">
                    <ImageView
                        android:id="@+id/roaming_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_roaming"
                        android:contentDescription="@string/cd_roaming_status"/>
                    <ImageView
                        android:id="@+id/roaming_blocked_overlay"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_blocked_overlay"
                        android:visibility="gone"
                        android:contentDescription="@string/cd_roaming_blocked"/>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
