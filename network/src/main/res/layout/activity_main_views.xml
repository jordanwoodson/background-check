<?xml version='1.0' encoding='utf-8'?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <!-- Top Bar with Firewall Toggle -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="2dp"
        android:fitsSystemWindows="false"
        app:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:background="?android:attr/colorBackground"
            android:clipToPadding="false"
            android:contentInsetStart="0dp"
            android:contentInsetStartWithNavigation="0dp"
            app:contentInsetStart="0dp"
            app:contentInsetStartWithNavigation="0dp"
            app:titleTextColor="?attr/colorOnPrimaryContainer">
            <!-- Custom toolbar content -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="56dp">
                    <ImageView
                        android:id="@+id/app_logo"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/bgcheck_network_icon"
                        android:contentDescription="@string/cd_de1984_logo"
                        android:padding="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"/>
                    <TextView
                        android:id="@+id/app_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_weight="1"/>
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="36dp"
                        android:src="@drawable/brand_mark"
                        android:importantForAccessibility="no"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:minHeight="48dp">
                    <TextView
                        android:id="@+id/toolbar_section_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/nav_firewall"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"/>
                    <LinearLayout
                        android:id="@+id/firewall_toggle_group"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone">
                        <!-- ACTIVE Badge -->
                        <TextView
                            android:id="@+id/firewall_active_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="@string/firewall_status_active"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/badge_text_success"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:background="@drawable/status_badge_active"
                            android:visibility="gone"/>
                        <!-- OFF Badge -->
                        <TextView
                            android:id="@+id/firewall_off_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="@string/firewall_button_off"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_white"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:background="@drawable/status_badge_off"
                            android:visibility="visible"/>
                        <!-- DOWN Badge: the firewall failed, as opposed to being switched off -->
                        <TextView
                            android:id="@+id/firewall_down_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="@string/firewall_status_down"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_white"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:background="@drawable/status_badge_down"
                            android:visibility="gone"/>
                        <!-- Firewall Toggle Switch -->
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/firewall_toggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            app:thumbTint="@color/switch_thumb_color"
                            app:trackTint="@color/switch_track_color"
                            app:trackDecorationTint="@android:color/transparent"/>
                    </LinearLayout>
                </LinearLayout>
                <ImageView
                    android:id="@+id/toolbar_icon"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"/>
                <TextView
                    android:id="@+id/toolbar_title"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"/>
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>
    <!--
        Firewall health warning. Lives here rather than inside the firewall fragment so it stays
        visible on every tab - including Settings, which is where the user goes to fix it.
        GONE by default; ConstraintLayout collapses it so the fragment sits under the app bar.
    -->
    <include
        android:id="@+id/firewall_health_banner"
        layout="@layout/firewall_health_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/app_bar_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <!-- Fragment Container -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/firewall_health_banner"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <!-- Material Design 3 Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        style="@style/Widget.De1984.BottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
